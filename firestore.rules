rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAllowedSleepPosition() {
      let x = request.resource.data.posX;
      let y = request.resource.data.posY;
      return (x == 205 && y == 230)
        || (x == 205 && y == 340)
        || (x == 205 && y == 450)
        || (x == 205 && y == 555)
        || (x == 760 && y == 325)
        || (x == 760 && y == 435)
        || (x == 760 && y == 545)
        || (x == 275 && y == 230)
        || (x == 275 && y == 340)
        || (x == 275 && y == 450)
        || (x == 275 && y == 555)
        || (x == 690 && y == 325)
        || (x == 690 && y == 435)
        || (x == 690 && y == 545)
        || (x == 210 && y == 215)
        || (x == 265 && y == 225);
    }

    function canUpdateSharedPlayerState() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly([
        'maxStamina',
        'stamina',
        'personalTime',
        'isSleeping',
        'readyToSleep',
        'isSick',
        'scratchUsedToday',
        'popularGiftUsedToday',
        'dailyNpcChatUsed',
        'dailyBuffs',
        'location',
        'posX',
        'posY'
      ])
      && (!changedKeys.hasAny(['readyToSleep']) || request.resource.data.readyToSleep == false)
      && (!changedKeys.hasAny(['location']) || request.resource.data.location in ['farm', 'house_interior'])
      && (!changedKeys.hasAny(['posX', 'posY']) || (
        isAllowedSleepPosition()
      ));
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;

      match /players/{playerId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.ownerUid == request.auth.uid;
        allow update: if signedIn() && (
          (
            resource.data.keys().hasAny(['ownerUid'])
            &&
            resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
          )
          || canUpdateSharedPlayerState()
        );
        allow delete: if signedIn()
          && resource.data.ownerUid == request.auth.uid;
      }
    }
  }
}
