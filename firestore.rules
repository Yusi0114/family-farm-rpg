rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function canUpdateSharedPlayerState() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly([
        'maxStamina',
        'stamina',
        'personalTime',
        'isSleeping',
        'readyToSleep',
        'isSick',
        'scratchUsedToday',
        'popularGiftUsedToday',
        'dailyNpcChatUsed',
        'dailyBuffs',
        'location',
        'posX',
        'posY'
      ])
      && (!changedKeys.hasAny(['readyToSleep']) || request.resource.data.readyToSleep == false)
      && (!changedKeys.hasAny(['location']) || request.resource.data.location == 'farm')
      && (!changedKeys.hasAny(['posX', 'posY']) || (
        (request.resource.data.posX == 210 && request.resource.data.posY == 215)
        || (request.resource.data.posX == 265 && request.resource.data.posY == 225)
      ));
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;

      match /players/{playerId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.ownerUid == request.auth.uid;
        allow update: if signedIn() && (
          (
            resource.data.keys().hasAny(['ownerUid'])
            &&
            resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
          )
          || canUpdateSharedPlayerState()
        );
        allow delete: if signedIn()
          && resource.data.ownerUid == request.auth.uid;
      }
    }
  }
}
